COMPOSE_PROJECT_NAME=sarapp-cloud-server-db-demo
SARAPP_CONNECT_CODE=DEMO-0001
SARAPP_SERVER_NAME=SARApp Cloud Server DB DEMO-0001
SARAPP_SERVER_ID=sarapp-cloud-server-db-demo-0001
SARAPP_CLOUD_ROUTER_URL=ws://sarapp-cloud:8765/tunnel/register
SARAPP_CLOUD_ROUTER_TOKEN=change-this-to-the-existing-router-token
CLOUD_ADMIN_USERNAME=admin
CLOUD_ADMIN_PASSWORD=change-this-password
CLOUD_SESSION_SECRET=change-this-to-a-long-random-string
TRAEFIK_DIRECT_ENABLE=false
TRAEFIK_NETWORK=cloud_server_sarapp-net
# Enables the dashboard Update button. Runs inside the app container.
CLOUD_UPDATE_COMMAND=cd /deploy/sarapp-cloud-server-db && git pull --ff-only && cd cloud_server && docker compose -p ${COMPOSE_PROJECT_NAME} --env-file .env up -d --build --remove-orphans

