# Static SPA serving for web_client/dist, mounted at /app (matches
# vite.config.ts's base: "/app/"). Uses HashRouter, so client-side routes
# live after "#" and never reach the server — no deep-path rewrite needed,
# just resolve /app/ and real asset paths under it.
#
# Also reverse-proxies /api/ (REST + the incident WebSocket, which lives
# under /api/incidents/{id}/ws) to this deployment's own backend, reached
# the same way desktop/mobile already reach it: cloud_router's public
# connect-code URL. This makes the standalone container work out of the
# box for anyone who opens this domain — no per-browser Connection
# Settings setup required for the common case. SARAPP_BACKEND_HOST and
# SARAPP_BACKEND_CONNECT_CODE are substituted by the nginx image's own
# envsubst-on-templates entrypoint from the container's environment (see
# docker-compose.yml) — deployment-specific values, never hardcoded here.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    location = / {
        return 302 /app/;
    }

    location /app/ {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /app/index.html;
    }

    location /api/ {
        proxy_pass https://${SARAPP_BACKEND_HOST}/r/${SARAPP_BACKEND_CONNECT_CODE}/api/;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        # Default is 1, too shallow for the backend's chain: nginx gave up
        # before reaching the trusted root even though that root was present
        # in proxy_ssl_trusted_certificate below (confirmed by curl, which
        # has no such depth limit, verifying the same chain against the
        # same bundle just fine while nginx logged "unable to get local
        # issuer certificate"). Bumped 1 -> 2 once already; the backend's
        # cert chain grew an extra hop again (leaf -> YR1 -> ISRG Root YR
        # (cross-signed) -> ISRG Root X1), so 2 fell short a second time.
        # Set generously above the currently observed chain length so a
        # future CA hierarchy change doesn't silently reintroduce this.
        proxy_ssl_verify_depth 5;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host ${SARAPP_BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
    }
}
